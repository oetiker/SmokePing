*** General ***

owner    = Peter Random
contact  = some@address.nowhere
mailhost = my.mail.host
sendmail = @SENDMAIL@
# NOTE: do not put the Image Cache below cgi-bin
# since all files under cgi-bin will be executed ... this is not
# good for images.
imgcache = @prefix@/cache
imgurl   = cache
datadir  = @prefix@/data
piddir  = @prefix@/var
cgiurl   = http://some.url/smokeping.cgi
smokemail = @prefix@/etc/smokemail.dist
tmail = @prefix@/etc/tmail.dist
# specify this to get syslog logging
syslogfacility = local0
# each probe is now run in its own process
# disable this to revert to the old behaviour
# concurrentprobes = no

*** Alerts ***
to = alertee@address.somewhere
from = smokealert@company.xy

+someloss
type = loss
# in percent
pattern = >0%,*12*,>0%,*12*,>0%
comment = loss 3 times  in a row

+rttdetect
type = rtt
# in seconds
pattern = >0.1,>0.1,>0.1
comment = delay above 100ms 3 times in a row

*** Database ***

step     = 300
pings    = 20

# consfn mrhb steps total

AVERAGE  0.5   1  28800
AVERAGE  0.5  12   9600
    MIN  0.5  12   9600
    MAX  0.5  12   9600
AVERAGE  0.5 144   2400
    MAX  0.5 144   2400
    MIN  0.5 144   2400

*** Presentation ***

template = @prefix@/etc/basepage.html.dist
htmltitle = yes
graphborders = no
# If enabled, treat all filter menu queries as literal strings instead of regex
literalsearch = no

+ charts

menu = Charts
title = The most interesting destinations

++ stddev
sorter = StdDev(entries=>4)
title = Top Standard Deviation
menu = Std Deviation
format = Standard Deviation %f

++ max
sorter = Max(entries=>5)
title = Top Max Roundtrip Time
menu = by Max
format = Max Roundtrip Time %f seconds

++ loss
sorter = Loss(entries=>5)
title = Top Packet Loss
menu = Loss
format = Packets Lost %f

++ median
sorter = Median(entries=>5)
title = Top Median Roundtrip Time
menu = by Median
format = Median RTT %f seconds

+ overview

width = 600
height = 50
range = 10h

+ detail

width = 600
height = 200
unison_tolerance = 2

"Last 3 Hours"    3h
"Last 30 Hours"   30h
"Last 10 Days"    10d
"Last 360 Days"   360d

+ multihost

colors = 004586 ff420e ffde20 579d1c 7e0021 83caff 314004 aecf00 4b1f6f ff950e c5000b 0084d1

#+ hierarchies
#++ owner
#title = Host Owner
#++ location
#title = Location

*** Probes ***

+ FPing

binary = /usr/bin/fping

+ DNS

binary = /usr/bin/dig
pings = 5
step = 300

+ Curl

binary = /usr/bin/curl
pings = 5
step = 300

# Uncomment if tcpping is installed
#+ TCPPing
#
#binary = /usr/bin/tcpping
#pings = 5
#forks = 10
#step = 300

*** Targets ***

probe = FPing

menu = Top
title = Network Latency Grapher
remark = Welcome to the SmokePing website of xxx Company. \
         Here you will learn all about the latency of our network.

+ InternetSites
menu = Internet Sites
title = ICMP Latency to Popular Sites

++ GoogleDNS
menu = Google DNS
title = Google Public DNS 8.8.8.8
host = 8.8.8.8
alerts = someloss

++ GoogleSearch
menu = Google
title = Google Search
host = www.google.com

++ CloudflareDNS
menu = Cloudflare DNS
title = Cloudflare Public DNS 1.1.1.1
host = 1.1.1.1

++ OpenDNS
menu = OpenDNS
title = OpenDNS 208.67.222.222
host = 208.67.222.222

+ DNSProbes
probe = DNS
menu = DNS Latency
title = DNS Query Latency

++ GoogleDNS
menu = Google DNS
title = DNS latency to Google Public DNS
host = 8.8.8.8
lookup = www.google.com

++ CloudflareDNS
menu = Cloudflare DNS
title = DNS latency to Cloudflare
host = 1.1.1.1
lookup = www.google.com

++ Quad9DNS
menu = Quad9 DNS
title = DNS latency to Quad9
host = 9.9.9.9
lookup = www.google.com

++ LocalDNS
menu = Local DNS
title = DNS latency to local resolver
host = 127.0.0.1
lookup = www.google.com

+ HTTPLatency
probe = Curl
menu = HTTP Latency
title = HTTP/HTTPS Response Latency

++ Google
menu = Google
title = HTTPS latency to Google
host = www.google.com
urlformat = https://%host%/

++ Cloudflare
menu = Cloudflare
title = HTTPS latency to Cloudflare
host = www.cloudflare.com
urlformat = https://%host%/
insecure_ssl = 1

++ Wikipedia
menu = Wikipedia
title = HTTPS latency to Wikipedia
host = www.wikipedia.org
urlformat = https://%host%/

++ GitHub
menu = GitHub
title = HTTPS latency to GitHub
host = github.com
urlformat = https://%host%/

+ MultiProbe
menu = Stack Graphs
title = Multi-Probe Comparison Graphs

++ DNSComparison
menu = DNS Resolvers
title = DNS Resolver Comparison (stacked)
host = /DNSProbes/GoogleDNS /DNSProbes/CloudflareDNS /DNSProbes/Quad9DNS /DNSProbes/LocalDNS

++ HTTPComparison
menu = HTTP Sites
title = HTTPS Latency Comparison (stacked)
host = /HTTPLatency/Google /HTTPLatency/Cloudflare /HTTPLatency/Wikipedia /HTTPLatency/GitHub

++ PublicDNSAll
menu = Public DNS All
title = Public DNS: ICMP vs DNS Query (stacked)
host = /InternetSites/GoogleDNS /InternetSites/CloudflareDNS /InternetSites/OpenDNS /DNSProbes/GoogleDNS /DNSProbes/CloudflareDNS /DNSProbes/Quad9DNS
